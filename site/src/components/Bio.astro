---
const bioHtml = `I'm a Senior Research Scientist at <a href="https://research.nvidia.com/labs/sil/">NVIDIA Spatial Intelligence Lab (SIL)</a>
and an Assistant Professor at the
<a href="https://www.cs.technion.ac.il/people/faculty/#:~:text=of%20visual%20tasks.-,Or%20Litany,-Senior%20Lecturer">Technion</a>,
specializing in 3D computer vision and generative AI. I'm honored to be a 2023 Azrieli Faculty Fellow
and a Taub Fellow. Previously, I conducted postdoctoral research at
<a href="https://geometry.stanford.edu/member/orlitany/">Stanford University</a> under
<a href="https://geometry.stanford.edu/member/guibas/">Prof. Leonidas Guibas</a>, and at
<a href="https://research.facebook.com/ai/">FAIR</a>, hosted by
<a href="https://people.eecs.berkeley.edu/~malik/">Prof. Jitendra Malik</a>. My PhD is from Tel-Aviv
University, advised by <a href="http://www.cs.technion.ac.il/~bron/">Prof. Alex Bronstein</a>. My B.Sc.
in Physics and Mathematics is from the Hebrew University.`.replace(/\n/g, ' ');

// The X mark is inlined rather than loaded via <img> so it can pick up
// currentColor; as an external SVG it renders pure black and disappears
// against the dark-mode background. The other icons are blue and read on
// both themes.
type SocialLink = {
  href: string;
  label: string;
  icon?: string;
  svg?: { viewBox: string; path: string };
};

const links: SocialLink[] = [
  { href: 'https://www.linkedin.com/in/orlitany/main.html', icon: '/images/linkedin.png', label: 'my linkedin profile page' },
  {
    href: 'https://x.com/orlitany',
    label: 'my X profile page',
    svg: {
      viewBox: '0 0 300 271',
      path: 'm236 0h46l-101 115 118 156h-92.6l-72.5-94.8-83 94.8h-46l107-123-113-148h94.9l65.5 86.6zm-16.1 244h25.5l-165-218h-27.4z',
    },
  },
  {
    href: 'https://scholar.google.co.il/citations?user=Ihs8dwsAAAAJ&hl=en',
    icon: '/images/google_scholar.png',
    label: 'my google scholar page',
  },
  { href: 'https://github.com/orlitany/', icon: '/images/github_alt.png', label: 'my github page' },
];
---

<div class="section bio" id="bio" itemscope itemtype="https://schema.org/Person">
  <div class="bio-text">
    <h1 itemprop="name">Or Litany</h1>
    <p class="email">or dot litany at gmail dot com</p>
    <p set:html={bioHtml} />
    <p class="bio-links">
      <a href="/latex/cv.pdf" aria-label="a pdf with my updated cv" class="pill-link">CV</a>
      {
        links.map((link) => (
          <>
            {' '}/{' '}
            <a href={link.href} aria-label={link.label} target={link.href.startsWith('http') ? '_blank' : undefined}>
              {link.svg ? (
                <svg class="icon" viewBox={link.svg.viewBox} fill="currentColor" aria-hidden="true" focusable="false">
                  <path d={link.svg.path} />
                </svg>
              ) : (
                <img src={link.icon} alt="" class="icon" />
              )}
            </a>
          </>
        ))
      }
    </p>
  </div>

  <div class="bio-photo">
    <img
      class="instructorphoto"
      id="orlitany"
      src="/images/or_yosemite_small_jpg.jpg"
      alt="Or Litany at Yosemite National Park"
    />
  </div>
</div>

<style>
  .bio {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-top: 3rem;
  }

  .bio-text {
    flex: 1 1 26rem;
  }

  .email {
    color: var(--text-muted);
    margin-top: -0.5em;
  }

  .bio-links {
    margin-top: 1.25em;
  }

  .icon {
    height: 18px;
    width: auto;
    vertical-align: middle;
  }

  .bio-photo {
    flex: 0 0 auto;
  }

  .instructorphoto {
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: var(--shadow);
  }

  @media (max-width: 700px) {
    .bio {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }
  }
</style>
