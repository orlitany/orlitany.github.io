---
import type { CollectionEntry } from 'astro:content';
import BibtexBlock from './BibtexBlock.astro';

interface Props {
  pub: CollectionEntry<'publications'>['data'];
}

const { pub } = Astro.props;
const isVideo = pub.image?.toLowerCase().endsWith('.mp4');
---

<article class="paper-entry" data-paper-id={pub.citekey}>
  {
    pub.image && (
      <div class="paper-image">
        {isVideo ? (
          <video src={pub.image} aria-label={pub.title} autoplay loop muted playsinline preload="auto" />
        ) : (
          <img src={pub.image} alt={pub.title} loading="lazy" />
        )}
      </div>
    )
  }

  <div class="paper-content">
    <p class="paper-title">
      <a href={pub.paper}>{pub.title}</a>
    </p>
    <p class="paper-authors">
      {
        pub.authors.map((author, i) => (
          <>
            {i > 0 && ', '}
            {author.isOrLitany ? (
              <strong>
                {author.firstName} {author.lastName}
              </strong>
            ) : (
              <>
                {author.firstName} {author.lastName}
              </>
            )}
          </>
        ))
      }
    </p>
    <p class="paper-venue">
      <em>{pub.venue}</em>
      {pub.award && <span class="badge">{pub.award}</span>}
    </p>

    <div class="paper-links">
      {pub.paper && <a href={pub.paper}>paper</a>}
      {pub.code && (
        <>
          {' '}/ <a href={pub.code}>code</a>
        </>
      )}
      {pub.page && (
        <>
          {' '}/ <a href={pub.page}>page</a>
        </>
      )}
      {pub.dataset && (
        <>
          {' '}/ <a href={pub.dataset}>dataset</a>
        </>
      )}
      {pub.slides && (
        <>
          {' '}/ <a href={pub.slides}>slides</a>
        </>
      )}
      {pub.poster && (
        <>
          {' '}/ <a href={pub.poster}>poster</a>
        </>
      )}
      {pub.talk && (
        <>
          {' '}/ <a href={pub.talk}>talk</a>
        </>
      )}
      {pub.tweet && (
        <>
          {' '}/ <a href={pub.tweet} target="_blank" rel="noopener">tweet</a>
        </>
      )}
      {' '}/ <button class="bibtex-toggle" data-citekey={pub.citekey} type="button">bibtex</button>
    </div>

    <BibtexBlock citekey={pub.citekey} raw={pub.raw} />
  </div>
</article>

<style>
  .paper-entry {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .paper-image {
    flex: 0 0 auto;
  }

  .paper-image img,
  .paper-image video {
    width: 150px;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
  }

  .paper-content {
    flex: 1 1 20rem;
    min-width: 0;
  }

  .paper-title {
    margin: 0 0 0.3em;
    font-weight: 600;
    font-size: 1.02em;
  }

  .paper-authors {
    margin: 0 0 0.3em;
    color: var(--text-muted);
    font-size: 0.92em;
  }

  .paper-venue {
    margin: 0 0 0.5em;
    font-size: 0.92em;
    display: flex;
    align-items: center;
    gap: 0.5em;
    flex-wrap: wrap;
  }

  .paper-links {
    font-size: 0.85em;
    color: var(--text-muted);
  }

  .bibtex-toggle {
    background: none;
    border: none;
    padding: 0;
    color: var(--accent);
    font-size: 1em;
    cursor: pointer;
    text-decoration: none;
  }

  .bibtex-toggle:hover {
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .paper-entry {
      flex-direction: column;
    }

    .paper-image img,
    .paper-image video {
      width: 120px;
    }
  }
</style>
