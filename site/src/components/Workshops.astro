---
import { getCollection } from 'astro:content';

const INITIAL_COUNT = 3;
const workshops = await getCollection('workshops');

const ORDINAL_RE = /^(\d+(?:st|nd|rd|th) \w+ (?:on|for) )(.+)$/i;

function describe(event: (typeof workshops)[number]['data']) {
  const { name, venue, year, type, link } = event;
  const match = ORDINAL_RE.exec(name);
  let coreName = name;
  let ordinalLabel: string | null = null;

  if (match) {
    coreName = match[2];
    const ordinal = /(\d+(?:st|nd|rd|th))/.exec(match[1])?.[1] ?? '';
    ordinalLabel = `${ordinal} ${type}`;
  }

  const descriptor = ordinalLabel
    ? `${ordinalLabel} at ${venue}, ${year}`
    : venue
      ? `${type} at ${venue}, ${year}`
      : `${type}, ${year}`;

  return { name: coreName, descriptor, link };
}
---

<div class="section" id="workshops">
  <h2>Workshops / Tutorials</h2>
  <ul class="workshops-list" id="workshops-list">
    {
      workshops.map((event, i) => {
        const { name, descriptor, link } = describe(event.data);
        return (
          <li class:list={{ extra: i >= INITIAL_COUNT, hidden: i >= INITIAL_COUNT }}>
            {link ? <a href={link}>{name}</a> : <span>{name}</span>} {descriptor}.
          </li>
        );
      })
    }
  </ul>
  {
    workshops.length > INITIAL_COUNT && (
      <div class="show-more-container">
        <button id="workshops-show-more" class="show-more-btn" type="button">
          Show more
        </button>
      </div>
    )
  }
</div>

<style>
  .workshops-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .workshops-list li {
    padding: 0.5em 0;
    border-bottom: 1px solid var(--border);
  }

  .workshops-list li:last-child {
    border-bottom: none;
  }

  .workshops-list li.extra.hidden {
    display: none;
  }

  .show-more-container {
    margin-top: 1.25em;
  }
</style>

<script>
  const button = document.getElementById('workshops-show-more');
  button?.addEventListener('click', () => {
    const list = document.getElementById('workshops-list');
    const extras = list?.querySelectorAll('li.extra');
    if (!extras || extras.length === 0) return;
    const isHidden = extras[0].classList.contains('hidden');
    extras.forEach((el) => el.classList.toggle('hidden', !isHidden));
    button.textContent = isHidden ? 'Show less' : 'Show more';
  });
</script>
