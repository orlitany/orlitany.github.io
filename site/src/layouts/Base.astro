---
import StickyNav from '../components/StickyNav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE_URL = 'https://orlitany.github.io';

const {
  title = 'Or Litany – 3D Computer Vision & Generative AI Researcher at NVIDIA and Technion',
  description = "Or Litany – Senior Research Scientist at NVIDIA and Assistant Professor at the Technion, specializing in 3D deep learning, generative AI, and computer vision. 2023 Azrieli Faculty Fellow and Taub Fellow.",
} = Astro.props;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'Or Litany',
      publisher: { '@id': `${SITE_URL}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Or Litany',
      alternateName: 'Or Litany',
      givenName: 'Or',
      familyName: 'Litany',
      gender: 'Male',
      email: 'or.litany@gmail.com',
      jobTitle: ['Senior Research Scientist', 'Assistant Professor'],
      knowsAbout: [
        '3D Computer Vision',
        'Generative AI',
        'Neural Rendering',
        'Novel View Synthesis',
        'Deep Learning',
        'Computer Vision',
        'Machine Learning',
        '3D Deep Learning',
      ],
      worksFor: [
        {
          '@type': 'Organization',
          name: 'NVIDIA',
          sameAs: 'https://www.nvidia.com/en-us/',
          department: 'NVIDIA Research',
        },
        {
          '@type': 'EducationalOrganization',
          name: 'Technion - Israel Institute of Technology',
          alternateName: 'Technion',
          sameAs: 'https://www.cs.technion.ac.il/',
          department: 'Computer Science',
        },
      ],
      alumniOf: [
        {
          '@type': 'EducationalOrganization',
          name: 'Stanford University',
          sameAs: [
            'https://ai.stanford.edu/',
            'https://www.stanford.edu/',
            'https://geometry.stanford.edu/index.html',
          ],
          department: 'Computer Science',
        },
        {
          '@type': 'EducationalOrganization',
          name: 'Tel-Aviv University',
          sameAs: 'https://english.tau.ac.il/',
        },
        {
          '@type': 'EducationalOrganization',
          name: 'Hebrew University of Jerusalem',
          sameAs: 'https://en.huji.ac.il/',
        },
      ],
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'degree',
          educationalLevel: 'Doctorate',
          about: 'Computer Science',
          recognizedBy: { '@type': 'EducationalOrganization', name: 'Tel-Aviv University' },
        },
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'degree',
          educationalLevel: 'Bachelor',
          about: 'Physics and Mathematics',
          recognizedBy: { '@type': 'EducationalOrganization', name: 'Hebrew University of Jerusalem' },
        },
      ],
      award: ['2023 Azrieli Faculty Fellow', 'Taub Fellow'],
      memberOf: [
        {
          '@type': 'Organization',
          name: 'ELLIS',
          description: 'European Laboratory for Learning and Intelligent Systems',
        },
      ],
      description,
      url: `${SITE_URL}/`,
      image: [
        `${SITE_URL}/images/orlitany_ieee_profilepic.jpg`,
        `${SITE_URL}/images/or_yosemite_small_jpg.jpg`,
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Sunnyvale',
        addressRegion: 'CA',
        addressCountry: 'US',
      },
      sameAs: [
        'https://www.linkedin.com/in/orlitany/',
        'https://www.facebook.com/OrLitovsky',
        'https://x.com/orlitany',
        'https://scholar.google.co.il/citations?user=Ihs8dwsAAAAJ&hl=en',
        'https://github.com/orlitany/',
        'https://dblp.org/pid/119/1476.html',
        'https://www.researchgate.net/profile/Or-Litany',
        `${SITE_URL}/`,
      ],
      mainEntityOfPage: { '@id': `${SITE_URL}/#website` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE_URL + Astro.url.pathname} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@orlitany" />
    <meta name="twitter:creator" content="@orlitany" />
    <meta name="twitter:title" content="Or Litany - 3D Computer Vision & Generative AI Researcher" />
    <meta
      name="twitter:description"
      content="Senior Research Scientist at NVIDIA and Assistant Professor at Technion, specializing in 3D computer vision and generative AI."
    />
    <meta name="twitter:image" content={`${SITE_URL}/images/orlitany_ieee_profilepic.jpg`} />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={SITE_URL + '/'} />
    <meta property="og:title" content="Or Litany - 3D Computer Vision & Generative AI Researcher" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/images/orlitany_ieee_profilepic.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Or" />
    <meta property="profile:last_name" content="Litany" />
    <meta property="profile:username" content="orlitany" />
    <meta name="theme-color" content="#1a1a2e" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />

    <!-- Set the theme before first paint to avoid a flash of the wrong theme -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GM4LVVKPRS" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-GM4LVVKPRS');
    </script>
  </head>
  <body>
    <StickyNav />
    <main>
      <slot />
    </main>
  </body>
</html>
